# ─────────────────────────────────────────────────────────────
# Investment Pitch Copilot — environment variables
# Copy to `.env.local` (dev) or set in your hosting dashboard.
# No real credentials are included here.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Local development uses a libSQL/SQLite file created on first run.
DATABASE_URL=file:./data/investment-pitch-copilot.db
# Production on Vercel: use a hosted libSQL database (e.g. Turso) so records
# persist across deployments and serverless instances.
# DATABASE_URL=libsql://your-database-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_AUTH_TOKEN=

# ── Data providers (all optional) ────────────────────────────
# The app runs fully without any provider credentials via manual entry.
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact address.
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=Investment Pitch Copilot (you@example.com)

# Synthetic demo data is clearly labelled and never presented as live data.
# Set to false to hide it from search and seeding.
ENABLE_DEMO_DATA=true

# ── Persistent server-side cache TTLs (in minutes) ───────────
# Search, profiles and annual statements change slowly; quotes change quickly.
CACHE_TTL_SEARCH_MINUTES=1440
CACHE_TTL_PROFILE_MINUTES=1440
CACHE_TTL_STATEMENTS_MINUTES=1440
CACHE_TTL_QUOTE_MINUTES=15
# Provider errors are cached briefly so exhausted quotas are not retried.
CACHE_TTL_ERROR_MINUTES=10
# Bad credentials / quota exhaustion are cached for longer.
CACHE_TTL_HARD_ERROR_MINUTES=360